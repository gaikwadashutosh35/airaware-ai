# Copy to server/.env for local development. Never commit .env.
# Further variables are added in the phase that first needs them (see docs/IMPLEMENTATION_PLAN.md §8).
NODE_ENV=development
# Cloud Run injects PORT in production; 8080 is the local default.
PORT=8080
# Optional, server-only: Gemini API key from Google AI Studio. Empty = rules-only daily plans.
GEMINI_API_KEY=
# Optional: Gemini model id (default gemini-3.8-flash).
# GEMINI_MODEL=gemini-3.8-flash
