# Copy to server/.env for local development. Never commit .env.
NODE_ENV=development
# Cloud Run injects PORT in production; 8080 is the local default.
PORT=8080
# Optional, server-only: Gemini API key from Google AI Studio. Empty = rules-only daily plans.
GEMINI_API_KEY=
# Optional: Gemini model id (default gemini-3.8-flash).
# GEMINI_MODEL=gemini-3.8-flash
# Optional, server-only: Anthropic API key. Claude writes the plan only when Gemini gives no accepted answer, and answers typed Ask questions.
ANTHROPIC_API_KEY=
# Optional: Claude model id (default claude-haiku-5-5).
# CLAUDE_MODEL=claude-haiku-5-5
# Optional: Google Maps Geocoding key for a device place's city name. Without it the place stays "Near you (approximate)".
GOOGLE_MAPS_API_KEY=
# Optional: NASA FIRMS MAP_KEY for fire hotspots near a place. Without it the card stays hidden.
FIRMS_MAP_KEY=
# Optional: Supabase project URL (https) and its publishable key (sb_publishable_...).
# Without both, saving is off. Never put the secret key here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
